<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="using:Avalonia.Data.Converters"
        xmlns:vm="using:jxr2uhdr.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="360"
        d:DesignHeight="260"
        x:Class="jxr2uhdr.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="JXR to Ultra HDR"
        Icon="/Assets/app-icon.ico"
        Width="360"
        Height="260"
        MinWidth="360"
        MinHeight="260"
        MaxWidth="360"
        MaxHeight="260"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Styles>
        <Style Selector="Button.output-folder">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource FolderIconBrush}"/>
        </Style>
        <Style Selector="Button.output-folder:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FolderHoverBrush}"/>
        </Style>
        <Style Selector="Button.output-folder.selected">
            <Setter Property="Background" Value="{DynamicResource FolderSelectedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FolderSelectedBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FolderSelectedForegroundBrush}"/>
        </Style>
        <Style Selector="Button.output-folder.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FolderSelectedHoverBrush}"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Border HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="320"
            Padding="22"
            Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="12"
            BoxShadow="0 4 16 0 #15000000">
        <Grid RowDefinitions="Auto,92,Auto"
              RowSpacing="18">
            <TextBlock Grid.Row="0"
                       Text="JXR to Ultra HDR"
                       FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <Grid Grid.Row="1">
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10"
                      VerticalAlignment="Center"
                      IsVisible="{Binding Summary, Converter={x:Static converters:StringConverters.IsNullOrEmpty}}">
                    <TextBlock Text="Quality"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Slider Grid.Column="1"
                            Minimum="1"
                            Maximum="100"
                            Value="{Binding Quality}"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            IsEnabled="{Binding State, Converter={x:Static converters:ObjectConverters.NotEqual}, ConverterParameter={x:Static vm:ConversionState.Converting}}"
                            Width="150"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding QualityText}"
                               Width="28"
                               Foreground="{DynamicResource BodyTextBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid RowDefinitions="26,Auto"
                      RowSpacing="12"
                      VerticalAlignment="Center"
                      IsVisible="{Binding Summary, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,10,0">
                        <Grid Height="26">
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding Progress}"
                                         Height="26" MinHeight="26"
                                         Foreground="{DynamicResource ProgressFillBrush}" CornerRadius="6"
                                         IsVisible="{Binding ShowStatusProgress}">
                                <ProgressBar.Template>
                                    <ControlTemplate>
                                        <Grid>
                                            <Border Name="PART_Indicator"
                                                    HorizontalAlignment="Left"
                                                    Background="{TemplateBinding Foreground}"
                                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="10,0">
                                <Panel Width="18"
                                       Height="18"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding State, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ConversionState.Pending}}">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="{DynamicResource PendingBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                </Panel>

                                <Panel Width="18"
                                       Height="18"
                                       VerticalAlignment="Center">
                                    <Path Data="M 5,5 L 13,13 M 13,5 L 5,13"
                                          Stroke="{DynamicResource ErrorBrush}"
                                          StrokeThickness="2"
                                          StrokeLineCap="Round"
                                          Fill="Transparent"
                                          IsVisible="{Binding State, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ConversionState.Error}}"/>
                                    <Path Data="M 3,9 L 7,13 L 15,5"
                                          Stroke="{DynamicResource SuccessBrush}"
                                          StrokeThickness="2.4"
                                          StrokeLineCap="Round"
                                          Fill="Transparent"
                                          IsVisible="{Binding State, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ConversionState.Done}}"/>
                                    <Path Data="M 9,2 A 7,7 0 1 1 4.05,4.05"
                                          Stroke="{DynamicResource ConvertingBrush}"
                                          StrokeThickness="2"
                                          StrokeLineCap="Round"
                                          Fill="Transparent"
                                          IsVisible="{Binding State, Converter={x:Static converters:ObjectConverters.Equal}, ConverterParameter={x:Static vm:ConversionState.Converting}}"
                                          RenderTransformOrigin="50%,50%">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="{Binding SpinnerAngle}"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Panel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Summary}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource BodyTextBrush}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding StatusTip}"/>

                            </Grid>
                        </Grid>
                        <Button Grid.Column="1"
                                Classes="output-folder"
                                Classes.selected="{Binding HasOutputDirectory}"
                                Command="{Binding ChooseOutputDirectoryCommand}"
                                CommandParameter="{Binding $parent[Window].StorageProvider}"
                                ToolTip.Tip="{Binding OutputDirectoryTip}"
                                AutomationProperties.Name="Select output directory">
                            <Path Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Fill="{Binding $parent[Button].Foreground}"
                                  Data="M 1,3.5 C 1,2.67 1.67,2 2.5,2 L 6.2,2 L 7.8,4 L 13.5,4 C 14.33,4 15,4.67 15,5.5 L 15,12.5 C 15,13.33 14.33,14 13.5,14 L 2.5,14 C 1.67,14 1,13.33 1,12.5 Z"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10">
                        <TextBlock Text="Quality"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Slider Grid.Column="1"
                                Minimum="1"
                                Maximum="100"
                                Value="{Binding Quality}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                IsEnabled="{Binding State, Converter={x:Static converters:ObjectConverters.NotEqual}, ConverterParameter={x:Static vm:ConversionState.Converting}}"
                                Width="150"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding QualityText}"
                                   Width="28"
                                   Foreground="{DynamicResource BodyTextBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Content="Select"
                        Command="{Binding AddFilesCommand}"
                        CommandParameter="{Binding $parent[Window].StorageProvider}"
                        IsEnabled="{Binding State, Converter={x:Static converters:ObjectConverters.NotEqual}, ConverterParameter={x:Static vm:ConversionState.Converting}}"
                        HorizontalAlignment="Stretch"
                        Classes="accent"/>
                <Button Grid.Column="1"
                        Content="Convert"
                        Command="{Binding ConvertCommand}"
                        IsEnabled="{Binding State, Converter={x:Static converters:ObjectConverters.NotEqual}, ConverterParameter={x:Static vm:ConversionState.Converting}}"
                        HorizontalAlignment="Stretch"
                        Classes="success"/>
            </Grid>
        </Grid>
    </Border>
</Window>
